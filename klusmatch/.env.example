# ── Core ─────────────────────────────────────────────────────────
# development | demo | production. Demo seeding only runs when APP_ENV=development or demo.
APP_ENV=development
APP_BASE_URL=http://localhost:3000
# Postgres connection. Supabase: use the pooled connection string (port 6543, ?sslmode=require).
DATABASE_URL=postgres://klusmatch:klusmatch@localhost:5432/klusmatch_dev

# ── AI (Claude) ──────────────────────────────────────────────────
# When unset, the intake uses the rule-based provider (no image analysis). Clearly shown in the UI.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ── WhatsApp Business Cloud API ──────────────────────────────────
# WHATSAPP_MODE=simulator keeps all outbound traffic local (shown in /dev/whatsapp).
# WHATSAPP_MODE=cloud_api sends through Meta's Graph API (requires the credentials below).
WHATSAPP_MODE=simulator
WHATSAPP_APP_SECRET=dev-app-secret-change-me
WHATSAPP_VERIFY_TOKEN=dev-verify-token-change-me
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0

# ── Storage ──────────────────────────────────────────────────────
# local (writes to ./.data/uploads) or supabase (Supabase Storage bucket)
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=klusmatch-media

# ── Feature flags ────────────────────────────────────────────────
FEATURE_BILLING=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Run background jobs inline after each request (dev convenience). In production run `npm run worker`.
INLINE_WORKER=true

# ── Operator identity (footer, legal pages, outreach e-mails) ─────
COMPANY_BRAND=KlusMatch
COMPANY_LEGAL_NAME=
COMPANY_KVK=
COMPANY_ADDRESS=
COMPANY_EMAIL=
COMPANY_PHONE=
# Set to true once the terms and privacy statement have been reviewed (removes the "concept" banner)
LEGAL_REVIEWED=false
