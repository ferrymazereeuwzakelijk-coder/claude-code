# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://mazashipping.com

# Where photos are loaded from. Leave unset to load them from the current Base44 hosting.
# After running `npm run images:download`, set this to /images to self-host them.
# NEXT_PUBLIC_IMAGE_BASE=/images

# Enquiry e-mail delivery via Resend (https://resend.com). Without a key, the
# form returns a clear error in production and logs submissions in development.
RESEND_API_KEY=
ENQUIRY_TO=marc@mazashipping.com
ENQUIRY_FROM="Maza Shipping website <website@mazashipping.com>"
