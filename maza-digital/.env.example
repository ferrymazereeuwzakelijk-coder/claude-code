# ---------------------------------------------------------------
# Brand & site
# ---------------------------------------------------------------
# Switch between "MAZA DIGITAL" and "MAZAMARKETING" without code changes.
NEXT_PUBLIC_BRAND_NAME="MAZA DIGITAL"
# Public production URL, no trailing slash. Used for sitemap, canonical URLs and Open Graph.
NEXT_PUBLIC_SITE_URL="https://www.mazadigital.nl"
# Public contact address shown on the site (use a business address, not a private one).
NEXT_PUBLIC_CONTACT_EMAIL="hallo@mazadigital.nl"
# Leave empty until the number is confirmed. International format without + or spaces, e.g. 31612345678
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# ---------------------------------------------------------------
# Enquiry form email delivery (Resend - https://resend.com)
# The form refuses submissions with a clear message until these are set.
# ---------------------------------------------------------------
RESEND_API_KEY=""
# Must be an address on a domain verified in Resend, e.g. "Maza Digital <website@mazadigital.nl>"
ENQUIRY_FROM_EMAIL=""
# Where new enquiries are delivered.
ENQUIRY_TO_EMAIL=""

# ---------------------------------------------------------------
# Spam protection (optional but recommended): Cloudflare Turnstile
# Honeypot + timing check + rate limiting are always active.
# ---------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ---------------------------------------------------------------
# Portfolio
# Unverified project placeholders are shown in development only.
# Set to "true" to also show them on a preview deployment.
# ---------------------------------------------------------------
NEXT_PUBLIC_SHOW_UNVERIFIED_PROJECTS="false"
